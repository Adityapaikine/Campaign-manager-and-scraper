# Public-search provider credentials used by Phase 5+ email-pattern discovery.
# Copy this file to .env and add ONLY the keys you actually use.
# Never commit .env or real credentials to source control.
#
# Source/portable build: .env may sit beside run.py / the EXE.
# Installed Phase-7 build: the app also checks its per-user config directory.
# Diagnostics reports provider names only; it never prints API-key values.

BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=

# Reserved optional verification-provider keys for future adapters.
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=
